# For use with docker-compose.yml
# Copy to .env.compose and fill in your values, then run:
#   docker-compose --env-file .env.compose up -d

# Discord Bot Token (required)
BOT_TOKEN=your_bot_token_here

# MySQL/MariaDB Passwords (required)
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_BISHOKUS_PASSWORD=your_bishokus_password_here

# Optional
TEST_BOT_TOKEN=
OPENWEATHER_API_KEY=
BLAGUES_API_KEY=
